# Backend
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=Dynamic PDF RAG API

# API / CORS
CORS_ORIGINS=https://your-frontend.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com

# Database
DATABASE_URL=postgresql://postgres:<password>@<supabase-host>:5432/postgres

# Redis
REDIS_URL=redis://default:<password>@<redis-host>:<port>

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or use the split variables below instead of CLOUDINARY_URL
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pdf-chatbot
CLOUDINARY_TIMEOUT_SECONDS=60

# Auth
JWT_SECRET=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
AUTH_PROVIDER=local
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30
AUTH_REFRESH_COOKIE_NAME=refresh_token

# App features
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
PDF_BACKGROUND_ENABLED=true
PDF_QUEUE_NAME=default
